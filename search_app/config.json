{
  "id": 'sorghum',
  "name": 'Sorghumbase',
  "url": 'https://sorghumbase.org',
  // ensemblURL / ensemblSite and details.primers are per-site: the Flask
  // page overrides them from live.cfg / dev.cfg (TARGET_SITE). The values
  // here are the live ones, for builds that run without Flask.
  "ensemblURL": 'https://ensembl.sorghumbase.org',
  "ensemblSite": 'https://ensembl.sorghumbase.org',
  "ensemblRest": 'https://data.gramene.org/pansite-ensembl-115',
  "grameneData": 'https://data.sorghumbase.org/sorghum_v11',
  // GXA instance (gramene-swagger /gxa/) the Expression tab's heatmaps query.
  // gramene-search defaults to the auth_testing instance when this is absent,
  // so it must be set explicitly per data release.
  "atlasUrl": 'https://data.sorghumbase.org/sorghum_v11/gxa/',
  "ga": 'G-L5KXDCCZ16',
  "playlistIds": [
    'PLqQHG-yuRY19bQtXH61sw7AAmsUrT-G_K'  // SB new list
  ],
  "curation": {
    "url": "http://curate.gramene.org/sorghum_v11?since=4479&gene=",
    "taxa": {
    }
  },
  showViews: true,
  views: {
    userLists: 'off',
    expression: 'disabled',
    export: 'off',
    taxonomy: 'hidden',
    taxTree: 'on',
    attrTable: 'off',
    list: 'on',
    help: 'off',
    attribs: 'hidden',
    exprViz: 'off',
    ontologyEnrichment: 'off'
  },
  "partialCompara": true,
  "enable_tbrowse_expression_zone": true,
  details: {
    sequences: true,
    // Primers tab (gramene-primers, incl. the Genotyping mode): off here;
    // PRIMERS_API in dev.cfg turns it on for dev.sorghumbase.org.
    primers: false,
    VEP: true,
    location: true,
    expression: true,
    homology: true,
    pathways: true,
    pubs: true,
    xrefs: true
  },
  "panSite" : {
    plants : {
      url: "https://gramene.org",
      name: "Gramene Plants",
      svg: "./static/images/main_logo.svg"
    },
    oryza_sativa : {
      url: "https://oryza.gramene.org",
      name: "Gramene Oryza",
      svg: "./static/images/oryza_logo.svg"
    },
    zea_maysb73 : {
      url: "https://maize-pangenome.gramene.org",
      name: "Gramene Maize",
      svg: "./static/images/maize_logo.svg"
    },
    vitis_vinifera : {
      url: "https://vitis.gramene.org",
      name: "Gramene Grapevine",
      svg: "./static/images/grapevine_logo.svg"
    }
  },
  "alertText": 'Click the search icon in the menu bar or type / to search'
}
