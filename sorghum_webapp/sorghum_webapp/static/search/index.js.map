}
function geneSteps(kit, { chapter, gene, search, copy } = {}) {
    const card = ()=>kit.findGeneCard(gene);
    const inCard = (selector)=>()=>kit.inGeneCard(gene, selector);
    const steps = [
        {
            key: "card",
            target: card,
            placement: "top",
            title: `${gene} is one of these genes`,
            content: `Let's look at the evidence behind ${gene}.`,
            before: async ()=>{
                await kit.ensureSearch(search);
                await kit.ensureView("list", ".result-gene");
                const c = await waitFor(card, {
                    timeout: 15e3
                });
                if (!c) return false;
                return revealTarget(c, {
                    block: "start"
                });
            }
        },
        {
            key: "tabs",
            target: inCard(".gene-detail-tabs"),
            placement: "top",
            title: "Evidence for each gene",
            content: `Each gene carries a row of tabs \u2014 Sequences, Location, Expression, Homology, Pathways, Papers, Xrefs and more. A tab is only offered when that evidence exists for the gene.`,
            before: async ()=>{
                const tabs = kit.inGeneCard(gene, ".gene-detail-tabs");
                if (!tabs) return false;
                return revealTarget(tabs, {
                    block: "center"
                });
            }
        },
        {
            key: "pathways",
            target: inCard(".pathways-container"),
            placement: "top",
            title: "Pathways: where the gene acts",
            content: `The tree on the left lists every Plant Reactome pathway and reaction the gene takes part in; the diagram shows the selected one with the gene flagged.`,
            before: async ()=>{
                await kit.ensureSearch(search);
                if (!await waitFor(card, {
                    timeout: 15e3
                })) return false;
                kit.act("doExpandGeneDetail", {
                    geneId: gene,
                    detail: "pathways"
                });
                const tree = await waitFor(inCard(".pathways-tree-panel .rstm-tree-item--active, .pathways-tree-empty"), {
                    timeout: 2e4
                });
                if (!tree) return false;
                await waitFor(()=>{
                    const frame = kit.inGeneCard(gene, ".pathways-diagram-panel iframe");
                    const doc = frame && frame.contentDocument;
                    return doc ? doc.querySelector("#holder canvas") : null;
                }, {
                    timeout: 1e4
                });
                return revealTarget(inCard(".pathways-container"), {
                    block: "start",
                    margin: roomAbove(320, 0.36),
                    settle: 800
                });
            }
        },
        {
            key: "tree",
            target: inCard(".gene-genetree"),
            placement: "top",
            title: "TBrowse: the gene family tree",
            content: `Opening Homology draws the gene family tree in TBrowse and the multiple sequence alignment zone (MSA). Click a triangle to expand or collapse a branch, or a gene name for more details. Protein domains are color coded; zoom in to the amino acid sequence level. `,
            before: async ()=>{
                kit.act("doExpandGeneDetail", {
                    geneId: gene,
                    detail: "homology"
                });
                kit.act("doSetHomologyViewer", {
                    geneId: gene,
                    viewer: "tbrowse"
                });
                const tree = await waitFor(inCard(".gene-genetree"), {
                    timeout: 2e4
                });
                if (!tree) return false;
                return revealTarget(tree, {
                    block: "start",
                    settle: 700
                });
            }
        },
        {
            key: "zones",
            target: inCard(".gene-genetree"),
            placement: "bottom",
            title: "Explore regional and functional conservation",
            content: `Switch between zones: Neighborhood to compare \xB110 flanking genes, and Expression to read an organ-level heatmap for genes with expression data.`,
            before: async ()=>{
                const zone = await waitFor(inCard(".gene-genetree .tbrowse-zone-toggle"), {
                    timeout: 15e3
                });
                if (!zone) return false;
                return revealTarget(zone, {
                    block: "start"
                });
            }
        }
    ];
    return withChapter(applyCopy(steps, copy), chapter);
}
function refineSteps(kit, { chapter, copy } = {}) {
    const container = kit.cls("facet-container");
    const steps = [
        {
            key: "refine",
            target: container,
            placement: "right",
            title: "Refine: what else is in this set",
            content: `Refine counts your current results by category, so you can see what you have before narrowing further. It stays collapsed until you open it, and the counts always describe the search in front of you. The number beside each value is how many of your genes match it \u2014 click it and that becomes a new filter, ANDed onto the search.`,
