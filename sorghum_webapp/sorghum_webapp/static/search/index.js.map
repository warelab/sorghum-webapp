function resultSetSteps(kit, { chapter, filterLabel, enter, copy } = {}) {
    const sidebar = kit.cls("sidebar");
    const filterContainer = kit.cls("filter-container");
    const menuOrFilters = ()=>document.querySelector(".gramene-filter-menu") || document.querySelector(filterContainer);
    const expansionBefore = (option)=>async ()=>{
            if (!await kit.ensureSearch()) return false;
            await revealTarget(filterContainer, {
                block: "start"
            });
            await kit.pickExpansion(filterLabel, option, 0);
            return !!await kit.openFilterMenu(filterLabel);
        };
    const steps = [
        {
            key: "panel",
            target: sidebar,
            placement: "right",
            title: "The search panel",
            content: `Accepting a suggestion runs the search. The left panel is now the state of that search: how many genes matched, the filters that produced them, and the views available to explore them.`,
            before: async ()=>{
                if (enter) await enter();
                if (!await kit.ensureSearch()) return false;
                await kit.ensureView("taxTree", ".results-vis");
                await kit.ensureView("list", ".result-gene");
                return revealTarget(sidebar, {
                    block: "start"
                });
            }
        },
        {
            key: "distribution",
            target: ".results-vis",
            placement: "bottom",
            title: "Where the matches are",
            content: `The top of the results shows how the matching genes are distributed across the species tree and along the genome \u2014 a quick read on whether a result set is broad or concentrated.`,
            before: async ()=>{
                await kit.clearExpansion(filterLabel);
                return revealTarget(".results-vis", {
                    block: "start"
                });
            }
        },
        {
            key: "filters",
            target: filterContainer,
            placement: "right",
            title: "Filters build the query",
            // Don't inherit the previous step's scroll position — stepping Back
            // arrives here with the sidebar scrolled elsewhere.
            before: async ()=>revealTarget(filterContainer, {
                    block: "start"
                }),
            content: `The term you accepted is now a filter, shown as "category | value". Filters combine with AND by default, so you can keep adding terms \u2014 a species, an expression class, a gene list \u2014 to narrow the set. Click one to negate it, switch AND/OR, or remove it.`
        },
        {
            // Intro: open the menu and explain the idea, but change nothing yet.
            key: "expand",
            target: menuOrFilters,
            placement: "right",
            title: "Expand the search",
            content: `Filters only ever narrow the search. "Expand search" grows it along a biological relationship instead: the genes you matched become the starting point, and the result is those genes plus everything reachable from them. There are three ways to do it \u2014 orthologs, paralogs and neighborhood. We take them one at a time; watch the gene count and taxonomic distribution as each is applied.`,
            before: async ()=>{
                if (!await kit.ensureSearch()) return false;
                await revealTarget(filterContainer, {
                    block: "start"
                });
                await kit.clearExpansion(filterLabel);
                return !!await kit.openFilterMenu(filterLabel);
            }
        },
        {
            key: "orthologs",
            target: menuOrFilters,
            placement: "right",
            title: "Expand by orthologs",
            content: `Orthologs are the equivalent genes in other genomes. This keeps every gene you already had and adds their counterparts in the other species, so the count climbs and the set spreads out across the species tree.`,
            before: expansionBefore("orthologs")
        },
        {
            key: "paralogs",
            target: menuOrFilters,
            placement: "right",
            title: "Expand by paralogs",
            content: `Paralogs stay inside a single genome \u2014 copies that arose by duplication rather than speciation. These are radio options, so picking paralogs switches straight from orthologs: the count changes in character as well as in size.`,
            before: expansionBefore("paralogs")
        },
        {
            key: "neighborhood",
            target: menuOrFilters,
            placement: "right",
            title: "Expand by neighborhood",
            content: `Neighborhood takes the ten genes either side of each match along the chromosome \u2014 genomic context rather than homology. Picking the selected option again clears it, which is what happens as we leave this step, so the rest of the tour runs on the plain search.`,
            before: expansionBefore("neighborhood"),
            after: async ()=>{
                await kit.clearExpansion(filterLabel);
                kit.closeFilterMenu(filterLabel);
            }
        },
        {
            key: "geneList",
            target: ".result-gene",
            placement: "top",
            title: "The gene list",
            content: `Below the taxonomic distribution is the paginated list of matching genes, each with its species, identifiers and description.`,
            before: async ()=>revealTarget(".result-gene", {
                    block: "start"
                })
        }
    ];
