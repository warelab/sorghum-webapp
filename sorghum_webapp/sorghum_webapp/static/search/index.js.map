function viewsSteps(kit, { chapter, copy } = {}) {
    const steps = [
        {
            key: "views",
            target: ".gramene-view-container",
            placement: "right",
            title: "Views sidebar panel",
            content: `The same result set can be read many ways. Toggle a view on to add it to the results column; click its name to jump straight to it.`,
